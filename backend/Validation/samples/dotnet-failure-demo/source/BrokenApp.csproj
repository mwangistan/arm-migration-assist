<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Target Name="ValidateArm64NativeDependency" BeforeTargets="CoreCompile"
          Condition="'$(RuntimeIdentifier)' == 'win-arm64'">
    <Error Text="ARM64 validation failure: Contoso.Native has only an x64 binary; the win-arm64 asset is missing." />
  </Target>
</Project>
