<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ArmMigrationAssist.Api</RootNamespace>
    <AssemblyName>ArmMigrationAssist.Api</AssemblyName>
    <!-- The four referenced Web projects each ship their own appsettings.json for standalone
         runs. The composed host publishes only its own; the referenced copies would collide on
         the same publish path and trigger NETSDK1152. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Assessment\RepositoryDiscovery\RepositoryDiscovery.csproj" />
    <ProjectReference Include="..\AutomatedMigration.Api\AutomatedMigration.Api.csproj" />
    <ProjectReference Include="..\MigrationPlanner\src\MigrationPlanner.Api\MigrationPlanner.Api.csproj" />
    <ProjectReference Include="..\Validation\Api\Validation.Api.csproj" />
  </ItemGroup>

</Project>
