<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MigrationPlanner</RootNamespace>
    <AssemblyName>MigrationPlanner</AssemblyName>
    <UserSecretsId>migration-planner-redesign</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.Inference" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\contracts\MigrationPlanV1.schema.json">
      <LogicalName>MigrationPlanV1.schema.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\contracts\RepositoryAssessmentV1.schema.json">
      <LogicalName>RepositoryAssessmentV1.schema.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\..\..\knowledge\windows-on-arm\corpus.json">
      <LogicalName>guidance-corpus.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
